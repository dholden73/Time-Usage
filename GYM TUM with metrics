WITH
equipment_scope AS (
  SELECT DISTINCT
    eq.equipment_id,
    eq.equipment_class_id,
    p.value AS equipment_fleet_id
  FROM datamart.equipment eq
  LEFT JOIN datamart.property p
    ON p.parent_datamart_sk = eq.datamart_sk
   AND p.property_id = 'Operational Group'
),
cal AS (
  SELECT
    period_start,
    period_end,
    CASE
      WHEN shift_name = 'Day Shift'   THEN 'DS'
      WHEN shift_name = 'Night Shift' THEN 'NS'
      ELSE NULL
    END AS shift_name,
    date::date AS shift_date
  FROM datamart.cal_shifts
  WHERE year = EXTRACT(YEAR FROM CURRENT_DATE)
),
jobs AS (
  SELECT
    jr.work_master_id,
    jr.excavator_id AS equipment_id,
    es.equipment_class_id,
    es.equipment_fleet_id,
    jr.mass,
    COALESCE(jr.end_time, jr.start_time) AS prod_time
  FROM datamart.job_response jr
  JOIN equipment_scope es
    ON es.equipment_id = jr.excavator_id
  WHERE jr.mass IS NOT NULL
    AND jr.excavator_id IS NOT NULL
  UNION ALL
  SELECT
    jr.work_master_id,
    jr.truck_id AS equipment_id,
    es.equipment_class_id,
    es.equipment_fleet_id,
    jr.mass,
    COALESCE(jr.end_time, jr.start_time) AS prod_time
  FROM datamart.job_response jr
  JOIN equipment_scope es
    ON es.equipment_id = jr.truck_id
  WHERE jr.mass IS NOT NULL
    AND jr.truck_id IS NOT NULL
),
prod_by_period AS (
  SELECT
    c.period_start,
    c.period_end,
    c.shift_name,
    c.shift_date,
    j.work_master_id,
    j.equipment_id,
    j.equipment_fleet_id,
    j.equipment_class_id,
    SUM(j.mass) AS tonnes
  FROM cal c
  LEFT JOIN jobs j
    ON j.prod_time >= c.period_start
   AND j.prod_time <  c.period_end
  GROUP BY
    c.period_start,
    c.period_end,
    c.shift_name,
    c.shift_date,
    j.work_master_id,
    j.equipment_id,
    j.equipment_fleet_id,
    j.equipment_class_id
),
denoms AS (
  SELECT
    c.period_start,
    c.period_end,
    c.shift_name,
    c.shift_date,
    se.equipment_id,
    SUM(
      CASE WHEN se.tum_ct THEN EXTRACT(EPOCH FROM (
        LEAST(COALESCE(se.end_time,'infinity'::timestamptz), c.period_end)
        - GREATEST(se.start_time, c.period_start)
      )) ELSE 0 END
    ) AS ct_s,
    SUM(
      CASE WHEN se.tum_st THEN EXTRACT(EPOCH FROM (
        LEAST(COALESCE(se.end_time,'infinity'::timestamptz), c.period_end)
        - GREATEST(se.start_time, c.period_start)
      )) ELSE 0 END
    ) AS st_s,
    SUM(
      CASE WHEN se.tum_at THEN EXTRACT(EPOCH FROM (
        LEAST(COALESCE(se.end_time,'infinity'::timestamptz), c.period_end)
        - GREATEST(se.start_time, c.period_start)
      )) ELSE 0 END
    ) AS at_s,
    SUM(
      CASE WHEN se.tum_ot THEN EXTRACT(EPOCH FROM (
        LEAST(COALESCE(se.end_time,'infinity'::timestamptz), c.period_end)
        - GREATEST(se.start_time, c.period_start)
      )) ELSE 0 END
    ) AS ot_s,
    SUM(
      CASE WHEN se.tum_wt THEN EXTRACT(EPOCH FROM (
        LEAST(COALESCE(se.end_time,'infinity'::timestamptz), c.period_end)
        - GREATEST(se.start_time, c.period_start)
      )) ELSE 0 END
    ) AS wt_s,
    SUM(
      CASE WHEN se.tum_pt THEN EXTRACT(EPOCH FROM (
        LEAST(COALESCE(se.end_time,'infinity'::timestamptz), c.period_end)
        - GREATEST(se.start_time, c.period_start)
      )) ELSE 0 END
    ) AS pt_s
  FROM cal c
  LEFT JOIN tum.source_event se
    ON se.event_range && tstzrange(c.period_start, c.period_end, '[)')
   AND se.equipment_id IN (SELECT equipment_id FROM equipment_scope)
  GROUP BY
    c.period_start,
    c.period_end,
    c.shift_name,
    c.shift_date,
    se.equipment_id
),
base AS (
  SELECT
		p.*, d.ct_s, d.st_s, d.at_s, d.ot_s, d.wt_s, d.pt_s
  FROM prod_by_period p
  LEFT JOIN denoms d
    ON d.period_start = p.period_start
   AND d.period_end   = p.period_end
   AND d.equipment_id = p.equipment_id
)
SELECT
  period_start,
  period_end,
  shift_name,
  shift_date,
  to_char(shift_date,'DD Mon') || ' - ' || shift_name AS shift_label,
  work_master_id,
  equipment_id,
  equipment_class_id,
  equipment_fleet_id,
  tonnes,
  tonnes / NULLIF(ct_s,0) * 3600.0 AS "Calendar",
  tonnes / NULLIF(st_s,0) * 3600.0 AS "Scheduled",
  tonnes / NULLIF(at_s,0) * 3600.0 AS "Available",
  tonnes / NULLIF(ot_s,0) * 3600.0 AS "Operating",
  tonnes / NULLIF(wt_s,0) * 3600.0 AS "Working",
  tonnes / NULLIF(pt_s,0) * 3600.0 AS "Productive"
FROM base
WHERE equipment_class_id = 'Prod Excavators'
