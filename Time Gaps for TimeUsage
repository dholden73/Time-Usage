SELECT
    equipment_id,
    start_time,
    end_time,
    prev_end_time,
    EXTRACT(EPOCH FROM start_time - prev_end_time) AS gap_duration
FROM (
    SELECT
        equipment_id,
        start_time,
        end_time,
        LAG(end_time) OVER (
            PARTITION BY equipment_id
            ORDER BY start_time
        ) AS prev_end_time
    FROM tum.source_event
) t
WHERE start_time > prev_end_time
ORDER BY equipment_id, start_time desc;
